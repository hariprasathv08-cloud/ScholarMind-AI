# Database Configuration
# In production, Render will automatically set DATABASE_URL.
# For local development, paste your Render or local PostgreSQL connection string here:
DATABASE_URL="postgresql://username:password@localhost:5432/studygpt"

# Custom Session Authentication
# Paste a random long secret string here for signing user sessions:
JWT_SECRET="study-gpt-ai-super-secret-jwt-signing-key-12345678"

# Google OAuth Credentials (Optional - only required if you use Continue with Google button)
# Obtain these from your Google Cloud Console (APIs & Services > Credentials):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Lovable AI Gateway
# Preserved for embedding and chat features:
LOVABLE_API_KEY=""
